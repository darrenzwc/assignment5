#!/bin/bash

if (( $# != 2 )); then
  echo "kubectl appshow <kind> <instance>"
  exit 1
fi

kind=$1
instance=$2

# KubePlus stores the custom resource in its provider namespace.  The
# resource's status.helmrelease value identifies the namespace created for
# that specific application instance as "<namespace>:<helm-release>".
instance_namespace=$(kubectl get "$kind" -A --no-headers 2>/dev/null \
  | awk -v instance="$instance" '$2 == instance { print $1; exit }')

if [[ -z "$instance_namespace" ]]; then
  echo "Instance $instance does not exist for Kind $kind."
  exit 1
fi

helmrelease=$(kubectl get "$kind" "$instance" -n "$instance_namespace" \
  -o jsonpath='{.status.helmrelease}' 2>/dev/null)
target_namespace=${helmrelease%%:*}

if [[ -z "$target_namespace" || "$target_namespace" == "$helmrelease" ]]; then
  echo "Unable to determine the application namespace for $kind $instance." >&2
  exit 1
fi

get_name() {
  local resource=$1
  local selector=${2:-}

  if [[ -n "$selector" ]]; then
    kubectl get "$resource" -n "$target_namespace" -l "$selector" \
      -o jsonpath='{.items[0].metadata.name}' 2>/dev/null
  else
    kubectl get "$resource" -n "$target_namespace" \
      -o jsonpath='{.items[0].metadata.name}' 2>/dev/null
  fi
}

pod=$(get_name pod 'app=greetings')
# Helm adds its own metadata labels to the Deployment, while the Pod template
# carries app=greetings. Each KubePlus instance has an isolated namespace and
# exactly one application Deployment, so query it without the Pod label filter.
deployment=$(get_name deployment)
configmap=$(get_name configmap 'app=greetings')
serviceaccount=$(get_name serviceaccount 'app=greetings')
# KubePlus adds a NetworkPolicy to every instance namespace.  It is the only
# NetworkPolicy expected in the namespace it creates for this assignment.
networkpolicy=$(get_name networkpolicy)

printf '{\n'
printf '  "pod": "%s",\n' "$pod"
printf '  "deployment": "%s",\n' "$deployment"
printf '  "configmap": "%s",\n' "$configmap"
printf '  "serviceaccount": "%s",\n' "$serviceaccount"
printf '  "networkpolicy": "%s"\n' "$networkpolicy"
printf '}\n'


